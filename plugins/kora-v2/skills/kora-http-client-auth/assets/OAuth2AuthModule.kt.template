package ${package}

import io.koraframework.common.annotation.Module
import io.koraframework.http.client.common.auth.HttpClientTokenProvider
import io.koraframework.http.client.common.interceptor.BasicAuthHttpClientInterceptor
import io.koraframework.http.client.common.interceptor.BearerAuthHttpClientInterceptor

/**
 * Supplies the two framework interceptors this setup needs.
 *
 * Requires: `OAuth2Config`, and an `HttpClientTokenProvider` in the graph
 * (`OAuth2ClientCredentialsProvider` carries `@Component`).
 *
 * The interceptor classes belong to the framework, so they cannot carry `@Component` — a `@Module`
 * factory is the only way to put them in the graph. Provide each of them **exactly once**: a second
 * provider gives `Multiple components match dependency:`, none gives
 * `No component found for dependency:` naming the interceptor type.
 *
 * Unlike `@ConfigSource` and `@HttpClient` interfaces, a hand-written `@Module` is not
 * auto-discovered — add it to the `@KoraApp` supertypes:
 *
 * ```kotlin
 * @KoraApp
 * interface Application : HoconConfigModule, JsonModule, LogbackModule, OkHttpClientModule,
 *     OAuth2AuthModule
 *
 * fun main() = KoraApplication.run { ApplicationGraph.graph() }
 * ```
 *
 * Attach them per client:
 *
 * ```kotlin
 * @InterceptWith(BearerAuthHttpClientInterceptor::class)
 * @HttpClient("httpClient.secureApi")
 * interface SecureApiClient
 * ```
 */
@Module
interface OAuth2AuthModule {

    /** Authenticates the token endpoint itself with the client id and secret. */
    fun oauth2ClientCredentials(config: OAuth2Config): BasicAuthHttpClientInterceptor =
        BasicAuthHttpClientInterceptor(config.clientId(), config.clientSecret())

    /** Adds `Authorization: Bearer <token>` to the business client's requests. */
    fun secureApiBearer(provider: HttpClientTokenProvider): BearerAuthHttpClientInterceptor =
        BearerAuthHttpClientInterceptor(provider)
}

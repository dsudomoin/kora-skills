// Bucket administration in Kora 2.0 — create the bucket at startup if it does not exist.
//
// Bucket administration is NOT part of the declarative @S3 contract, so it goes through the AWS SDK
// client published by io.koraframework:s3-client-aws. An application that also wants declarative
// @S3.Client interfaces pulls in BOTH artifacts and extends BOTH modules:
//
//   implementation "io.koraframework:s3-client-aws"
//   implementation "io.koraframework.experimental:s3-client-kora"
//   implementation "io.koraframework:http-client-ok"
//
//   @KoraApp
//   public interface Application extends
//           HoconConfigModule, LogbackModule, OkHttpClientModule,
//           AwsS3ClientModule,      // this file
//           KoraS3ClientModule { }  // the @S3.Client interfaces
//
// Replace `com.example.storage` with your package.

package com.example.storage;

import io.koraframework.application.graph.Lifecycle;
import io.koraframework.common.annotation.Component;
import io.koraframework.common.annotation.Root;
import io.koraframework.config.common.annotation.ConfigSource;

import software.amazon.awssdk.services.s3.S3Client;
import software.amazon.awssdk.services.s3.model.CreateBucketRequest;
import software.amazon.awssdk.services.s3.model.HeadBucketRequest;
import software.amazon.awssdk.services.s3.model.NoSuchBucketException;

/**
 * {@code @Root} IS LOAD-BEARING. This component prepares external state and nothing depends on it,
 * so without {@code @Root} the graph prunes it — and the {@code S3Client} it pulled in goes with
 * it. The failure names the SDK type rather than this class:
 *
 * <pre>
 * interface software.amazon.awssdk.services.s3.S3Client wasn't found in graph
 * </pre>
 */
@Root
@Component
public final class S3BucketInitializer implements Lifecycle {

    private final S3Client s3Client;
    private final S3UploadsConfig config;

    public S3BucketInitializer(S3Client s3Client, S3UploadsConfig config) {
        this.s3Client = s3Client;
        this.config = config;
    }

    @Override
    public void init() {
        var bucket = this.config.bucket();
        try {
            this.s3Client.headBucket(HeadBucketRequest.builder().bucket(bucket).build());
        } catch (NoSuchBucketException e) {
            this.s3Client.createBucket(CreateBucketRequest.builder().bucket(bucket).build());
        }
    }

    @Override
    public void release() {}

    /**
     * The declarative client reads its bucket through {@code @S3.Bucket}, which produces a generated
     * class rather than an injectable component — so code that needs the name separately reads the
     * same config path itself. Point {@code @S3.Bucket(".bucket")} at {@code s3client.uploads.bucket}
     * and this interface at the same place.
     */
    @ConfigSource("s3client.uploads")
    public interface S3UploadsConfig {

        String bucket();
    }
}

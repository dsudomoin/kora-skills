// ============== CONFIGURATION ==============

// application.conf (HOCON):
//
// scheduling {
//   quartz {
//     # raw org.quartz.* passthrough — Kora 1.x put these at the root `quartz { }`, which 2.0 ignores
//     properties {
//       "org.quartz.threadPool.threadCount" = "10"
//     }
//     waitForJobComplete = true    # default true; shutdown blocks until running jobs finish
//   }
//
//   telemetry {
//     logging.enabled = true       # default false
//     metrics.enabled = true       # default false — needs a MeterRegistry in the graph
//     tracing.enabled = true       # default true  — needs a Tracer in the graph
//   }
// }
//
// jobs.hourly {
//   cron = "0 0 * * * ?"
//   telemetry.logging.enabled = true    # per-job override, only for the `config` form
// }


// Kora 2.x — single-module Java service.
// Kora 2.0 artifacts are built for Java 25; the toolchain below is the minimum, not a preference.

plugins {
    id "java"
    id "application"
}

repositories {
    mavenCentral()
}

configurations {
    koraBom
    annotationProcessor.extendsFrom(koraBom)
    compileOnly.extendsFrom(koraBom)
    implementation.extendsFrom(koraBom)
    testImplementation.extendsFrom(koraBom)
    testAnnotationProcessor.extendsFrom(koraBom)
}

dependencies {
    // koraVersion lives in gradle.properties
    koraBom platform("io.koraframework:kora-bom:$koraVersion")

    // Mandatory: without it nothing is generated and the only symptom is
    // "cannot find symbol: ApplicationGraph"
    annotationProcessor "io.koraframework:annotation-processors"

    implementation "io.koraframework:config-hocon"
    implementation "io.koraframework:logging-logback"

    // Add as needed — every one of these also needs its module in the @KoraApp extends clause:
    // implementation "io.koraframework:json-common"              // JsonModule
    // implementation "io.koraframework:database-jdbc"            // JdbcDatabaseModule
    // implementation "io.koraframework:validation-module"        // ValidationModule
    // implementation "io.koraframework:micrometer-module"        // MetricsModule
    // implementation "io.koraframework:http-server-undertow"     // UndertowPublicHttpServerModule

    // Test sources that declare Kora annotations need their own processor
    testAnnotationProcessor "io.koraframework:annotation-processors"
    testImplementation "io.koraframework:test-junit5"
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(25)
        vendor = JvmVendorSpec.ADOPTIUM
    }
}

application {
    applicationName = "application"
    mainClass = "${packagePath}.Application"
    applicationDefaultJvmArgs = ["-Dfile.encoding=UTF-8"]
}

distTar {
    archiveFileName = "application.tar"
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = "UTF-8"

    // Uncomment to see how the processor resolved the graph; it also writes build/kora/log/
    // options.compilerArgs += ["-AkoraLogLevel=DEBUG"]

    // Only for the "test @KoraApp extends the production @KoraApp" pattern. Set it on the MAIN
    // compilation; without it the test graph silently loses the production @Component classes.
    // options.compilerArgs += ["-Akora.app.submodule.enabled=true"]
}

test {
    useJUnitPlatform()
    testLogging {
        events "passed", "skipped", "failed"
        showStandardStreams = true
        exceptionFormat = "full"
    }
}

# Kora 2.x application configuration — HOCON (io.koraframework:config-hocon, HoconConfigModule).
# Loaded from src/main/resources/application.conf.
# Typed config, @ConfigSource and @ConfigMapper are covered by the kora-config-hocon skill.

# Log levels are a Map<String, String> under `logging.levels` (io.koraframework.logging.common).
logging {
  levels {
    "ROOT": "WARN"
    "${packagePath}": "INFO"
    "io.koraframework": "INFO"
  }
}

# Environment substitution:
#   ${VAR}   required — startup fails if the variable is unset
#   ${?VAR}  optional — the key is left unset if the variable is absent
#
# app {
#   name = ${APP_NAME}
#   region = ${?APP_REGION}
# }

package ${packagePath};

import io.koraframework.application.graph.KoraApplication;
import io.koraframework.common.annotation.KoraApp;
import io.koraframework.config.hocon.HoconConfigModule;
import io.koraframework.logging.logback.LogbackModule;

/**
 * Application entry point — the Kora 2.x dependency container configuration.
 *
 * <p>@KoraApp is only valid on an interface. The processor generates {@code ApplicationGraph}
 * into THIS package (name = interface simple name + "Graph"), so it is referenced unqualified
 * and must never be imported from io.koraframework.
 *
 * <p>Modules shipped as artifacts must be listed in {@code extends}. A @Module interface compiled
 * in this same Gradle module is discovered automatically and must not be listed.
 *
 * <p>Commonly added modules:
 * <ul>
 *   <li>{@code io.koraframework.json.common.JsonModule}                              — json-common
 *   <li>{@code io.koraframework.database.jdbc.JdbcDatabaseModule}                    — database-jdbc
 *   <li>{@code io.koraframework.validation.module.ValidationModule}                  — validation-module
 *   <li>{@code io.koraframework.micrometer.module.MetricsModule}                     — micrometer-module
 *   <li>{@code io.koraframework.http.server.undertow.UndertowPublicHttpServerModule} — http-server-undertow
 * </ul>
 *
 * <p>See: references/kora-app-component-reference.md
 */
@KoraApp
public interface Application extends
    HoconConfigModule,
    LogbackModule {

    static void main(String[] args) {
        KoraApplication.run(ApplicationGraph::graph);
    }
}

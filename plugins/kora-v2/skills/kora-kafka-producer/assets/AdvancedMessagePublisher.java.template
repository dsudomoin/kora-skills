package ${packagePath}.publisher;

import org.apache.kafka.clients.producer.Callback;
import org.apache.kafka.clients.producer.ProducerRecord;
import org.apache.kafka.common.header.Headers;
import io.koraframework.kafka.common.annotation.KafkaPublisher;
import io.koraframework.kafka.common.annotation.KafkaPublisher.Topic;

// Headers, Callback and full ProducerRecord control.
//
// The two interfaces below deliberately share one config path but stay separate:
// a single @KafkaPublisher interface may use EITHER @Topic methods OR ProducerRecord
// methods, never both. Mixing them makes the generated $X_TopicConfig record and the
// $X_PublisherModule factory disagree on arity, and javac rejects the generated code:
//
//   error: constructor $X_TopicConfig in record $X_TopicConfig cannot be applied to
//          given types; required: TopicConfig,TopicConfig  found: TopicConfig
//
// In Kotlin the same mix only breaks when a ProducerRecord method is declared before a
// @Topic one, which looks like an unrelated ordering bug.
@KafkaPublisher("kafka.producer.advancedPublisher")
public interface AdvancedMessagePublisher {

    @Topic(".topic")
    void send(String key, String value, Headers headers);

    @Topic(".topic")
    void send(String key, String value, Headers headers, Callback callback);
}

// Topic comes from the record itself, so these methods carry no @Topic.
@KafkaPublisher("kafka.producer.advancedPublisher")
interface MessageRecordPublisher {

    void send(ProducerRecord<String, String> record);

    void send(ProducerRecord<String, String> record, Callback callback);
}

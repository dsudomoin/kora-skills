package ${packagePath}.publisher;

import java.util.concurrent.CompletionStage;
import java.util.concurrent.Future;
import org.apache.kafka.clients.producer.Callback;
import org.apache.kafka.clients.producer.RecordMetadata;
import org.apache.kafka.common.header.Headers;
import io.koraframework.kafka.common.annotation.KafkaPublisher;
import io.koraframework.kafka.common.annotation.KafkaPublisher.Topic;

// Every send signature the Kora 2.0 publisher processor accepts with @Topic.
// A @Topic value starting with "." is resolved against the @KafkaPublisher path,
// so ".topic" below means kafka.producer.myPublisher.topic.
//
// void and RecordMetadata BLOCK until the broker acks and throw KafkaPublishException
// on failure; the Future/CompletionStage forms return immediately and report the
// failure through the returned handle.
//
// Do not add a ProducerRecord method to this interface — see MessageRecordPublisher
// in AdvancedMessagePublisher.java.template for why they must live apart.
@KafkaPublisher("kafka.producer.myPublisher")
public interface MessagePublisher {

    @Topic(".topic")
    void send(String value);

    @Topic(".topic")
    void send(String key, String value);

    @Topic(".topic")
    void send(String key, String value, Headers headers);

    @Topic(".topic")
    void send(String value, Callback callback);

    @Topic(".topic")
    RecordMetadata sendWithMeta(String value);

    @Topic(".topic")
    Future<RecordMetadata> sendAsync(String value);

    @Topic(".topic")
    CompletionStage<RecordMetadata> sendStage(String value);
}

package ${packagePath}.publisher;

import static org.junit.jupiter.api.Assertions.*;

import java.time.Duration;
import java.util.List;
import java.util.Properties;
import java.util.concurrent.ExecutionException;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.TimeoutException;
import org.apache.kafka.clients.consumer.ConsumerConfig;
import org.apache.kafka.clients.consumer.ConsumerRecord;
import org.apache.kafka.clients.consumer.KafkaConsumer;
import org.apache.kafka.common.serialization.StringDeserializer;
import org.junit.jupiter.api.Test;
import org.testcontainers.kafka.KafkaContainer;
import io.koraframework.test.extension.junit5.KoraAppTest;
import io.koraframework.test.extension.junit5.KoraAppTestConfigModifier;
import io.koraframework.test.extension.junit5.KoraConfigModification;
import io.koraframework.test.extension.junit5.TestComponent;
import ${packagePath}.Application;

// Integration test for a Kora 2.0 Kafka publisher.
//
// Dependencies (see build.gradle.template):
//   testImplementation "io.koraframework:test-junit5"
//   testImplementation "org.testcontainers:testcontainers-kafka:2.0.5"
// Testcontainers 2.x renamed its modules: "org.testcontainers:kafka" does not exist any
// more, and the KRaft container class is org.testcontainers.kafka.KafkaContainer.
//
// The container is started from a static initializer rather than @Testcontainers/@Container
// so that it is running before ANY JUnit extension callback — the Kora extension builds the
// application graph in beforeAll, and extension ordering is not something to gamble on.
@KoraAppTest(Application.class)
class MessagePublisherTests implements KoraAppTestConfigModifier {

    private static final String TOPIC = "my-topic";

    static final KafkaContainer KAFKA = new KafkaContainer("apache/kafka-native:4.3.1");

    static {
        KAFKA.start();
    }

    @TestComponent
    private MessagePublisher publisher;

    @Override
    public KoraConfigModification config() {
        // application.conf substitutes KAFKA_BOOTSTRAP_SERVERS; nothing else needs overriding.
        return KoraConfigModification.ofSystemProperty("KAFKA_BOOTSTRAP_SERVERS", KAFKA.getBootstrapServers());
    }

    @Test
    void sendBlocksUntilAcknowledged() {
        var value = "test-message-" + System.nanoTime();

        try (var consumer = consumer("send-blocks")) {
            consumer.subscribe(List.of(TOPIC));
            consumer.poll(Duration.ofSeconds(1));   // force assignment before producing

            publisher.send(value);

            var record = pollOne(consumer);
            assertNull(record.key());
            assertEquals(value, record.value());
        }
    }

    @Test
    void sendWithKey() {
        var key = "key-" + System.nanoTime();
        var value = "value-" + System.nanoTime();

        try (var consumer = consumer("send-with-key")) {
            consumer.subscribe(List.of(TOPIC));
            consumer.poll(Duration.ofSeconds(1));

            publisher.send(key, value);

            var record = pollOne(consumer);
            assertEquals(key, record.key());
            assertEquals(value, record.value());
        }
    }

    @Test
    void sendWithMetaReturnsBrokerMetadata() {
        var value = "meta-" + System.nanoTime();

        var metadata = publisher.sendWithMeta(value);

        assertEquals(TOPIC, metadata.topic());
        assertTrue(metadata.offset() >= 0);
    }

    @Test
    void sendAsyncCompletesWithMetadata() throws ExecutionException, InterruptedException, TimeoutException {
        var value = "async-" + System.nanoTime();

        var metadata = publisher.sendAsync(value).get(30, TimeUnit.SECONDS);

        assertEquals(TOPIC, metadata.topic());
    }

    private KafkaConsumer<String, String> consumer(String group) {
        var props = new Properties();
        props.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, KAFKA.getBootstrapServers());
        props.put(ConsumerConfig.GROUP_ID_CONFIG, group + "-" + System.nanoTime());
        props.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class.getName());
        props.put(ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class.getName());
        props.put(ConsumerConfig.AUTO_OFFSET_RESET_CONFIG, "earliest");
        props.put(ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, "true");
        return new KafkaConsumer<>(props);
    }

    private static ConsumerRecord<String, String> pollOne(KafkaConsumer<String, String> consumer) {
        var deadline = System.nanoTime() + Duration.ofSeconds(30).toNanos();
        while (System.nanoTime() < deadline) {
            var records = consumer.poll(Duration.ofSeconds(1));
            if (!records.isEmpty()) {
                return records.iterator().next();
            }
        }
        return fail("No record arrived within 30s");
    }
}

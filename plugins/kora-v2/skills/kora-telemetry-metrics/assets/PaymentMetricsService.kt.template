package ${package}

import io.koraframework.common.annotation.Component
import io.micrometer.core.instrument.Counter
import io.micrometer.core.instrument.DistributionSummary
import io.micrometer.core.instrument.MeterRegistry
import io.micrometer.core.instrument.Timer
import java.time.Duration
import java.util.function.Supplier

/**
 * Payment processing metrics (Kora 2.0) -- a complete worked example.
 *
 * Demonstrates:
 * - one metric name with a bounded status tag, so success and failure ratio cleanly
 * - a Timer with SLO buckets that match real latency targets
 * - a DistributionSummary with an explicit base unit for a business quantity
 *
 * Kora 2.0 contracts are synchronous, so this is an ordinary blocking function -- no Mono,
 * no CompletionStage, no suspend.
 */
@Component
class PaymentMetricsService(
    registry: MeterRegistry
) {

    // Same metric name, different bounded status tag: one Prometheus series family
    // you can ratio without joining two metrics.
    private val paymentsCounter: Counter = registry.counter("payment.processed.total", "status", "success")
    private val failuresCounter: Counter = registry.counter("payment.processed.total", "status", "failed")

    private val paymentTimer: Timer = Timer.builder("payment.processing.duration")
        .description("Time taken to process payment")
        .serviceLevelObjectives(
            Duration.ofMillis(50),
            Duration.ofMillis(100),
            Duration.ofMillis(500),
            Duration.ofSeconds(1),
            Duration.ofSeconds(5)
        )
        .register(registry)

    private val paymentAmount: DistributionSummary = DistributionSummary.builder("payment.amount")
        .description("Payment amount distribution")
        .tag("currency", "RUB")
        .baseUnit("rubles")
        .register(registry)

    /**
     * The Supplier { } wrapper is deliberate: Timer.record is overloaded for Runnable and
     * Supplier<T>, and Kotlin cannot pick between them from a value-returning lambda.
     */
    fun process(payment: Payment): PaymentResult =
        paymentTimer.record(Supplier {
            try {
                val result = executePayment(payment)
                paymentsCounter.increment()
                paymentAmount.record(payment.amount)
                result
            } catch (e: PaymentException) {
                failuresCounter.increment()
                throw e
            }
        })

    private fun executePayment(payment: Payment): PaymentResult {
        // Business logic here.
        return PaymentResult(true, "Payment processed successfully")
    }

    data class Payment(val amount: Double, val currency: String = "RUB")

    data class PaymentResult(val success: Boolean, val message: String)

    class PaymentException(message: String) : RuntimeException(message)
}

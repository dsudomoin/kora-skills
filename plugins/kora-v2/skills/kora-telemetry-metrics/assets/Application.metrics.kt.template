package ${package}

import io.koraframework.application.graph.KoraApplication
import io.koraframework.common.annotation.KoraApp
import io.koraframework.config.hocon.HoconConfigModule
import io.koraframework.http.server.undertow.UndertowPublicHttpServerModule
import io.koraframework.logging.logback.LogbackModule
import io.koraframework.micrometer.module.MetricsModule

/**
 * Kora 2.0 application with metrics.
 *
 * MetricsModule publishes the MeterRegistry and the MetricsScraper. Without it the
 * /metrics endpoint answers 200 with the body "# Metric Scraper disabled", and every
 * component's metrics flag is inert because the telemetry factories receive a null
 * MeterRegistry.
 *
 * UndertowPublicHttpServerModule extends UndertowSystemHttpServerModule, so the system
 * server that serves /metrics, /system/liveness and /system/readiness comes with it.
 *
 * Component metrics are still OFF until application.conf enables them per component --
 * see application.metrics.conf.template.
 *
 * ApplicationGraph is generated by the Kora symbol processor (KSP) at build time.
 */
@KoraApp
interface Application :
    HoconConfigModule,
    LogbackModule,
    MetricsModule,
    UndertowPublicHttpServerModule

fun main() {
    KoraApplication.run(ApplicationGraph::graph)
}

// YAML Configuration dependencies (Kora 2.0)
// Alternative to HOCON - choose one format (HOCON is recommended)

dependencies {
    // YAML configuration module
    implementation "io.koraframework:config-yaml"

    // Logging (required for config change notifications)
    implementation "io.koraframework:logging-logback"
}

// Usage in the @KoraApp interface:
//   @KoraApp
//   public interface Application extends YamlConfigModule { ... }
//
// Configuration file: src/main/resources/application.yaml
//
// YAML substitution syntax:
// - Required substitution:  url: ${DATABASE_URL}
// - Optional substitution:  password: ${?DATABASE_PASSWORD}   (key stays absent when unset)
// - Default value:          port: ${PORT:8080}                (8080 unless PORT is set - no `?`)
// - Reference another key:  greeting: ${app.name}Other${app.name}
//
// The same 2.0 section renames apply as for HOCON:
//   httpServer.port / httpServer.system.port, jdbc { ... }, openapi.management.files

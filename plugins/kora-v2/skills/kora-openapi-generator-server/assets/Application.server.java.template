// Kora 2.x — @KoraApp for a generated OpenAPI HTTP server (Java)
package com.example.petapi;

import io.koraframework.application.graph.KoraApplication;
import io.koraframework.common.Principal;
import io.koraframework.common.annotation.KoraApp;
import io.koraframework.common.annotation.Tag;
import io.koraframework.config.hocon.HoconConfigModule;
import io.koraframework.http.common.auth.PrincipalWithScopes;
import io.koraframework.http.server.common.auth.HttpServerPrincipalExtractor;
import io.koraframework.http.server.common.response.HttpServerResponseException;
import io.koraframework.http.server.undertow.UndertowPublicHttpServerModule;
import io.koraframework.json.common.JsonModule;
import io.koraframework.logging.logback.LogbackModule;
import io.koraframework.validation.module.ValidationModule;
import io.koraframework.validation.module.http.server.ViolationExceptionHttpServerResponseMapper;

// Generated by the OpenAPI generator into apiPackage when the contract declares
// components.securitySchemes. Imported only to reference its nested tag markers.
import com.example.petapi.api.ApiSecurity;

@KoraApp
public interface Application extends
        HoconConfigModule,
        LogbackModule,
        JsonModule,                       // generated models need JsonReader/JsonWriter
        ValidationModule,                 // only with enableServerValidation = "true"
        UndertowPublicHttpServerModule {  // 2.0 name; 1.x was UndertowHttpServerModule

    // Do NOT extend the generated ApiSecurity / *ApiModule / *ApiControllerModule interfaces.
    // They carry @Module and the @KoraApp processor discovers every @Module interface in the
    // compilation round. Extending them here changes nothing and invites duplicate components.

    static void main(String[] args) {
        KoraApplication.run(ApplicationGraph::graph);
    }

    // Optional: shape the 400 body produced when @Validate throws ViolationException.
    // The framework injects this as @Nullable, so omitting it falls back to a plain 400.
    // A default method on @KoraApp is already a module factory — do not add @Component.
    default ViolationExceptionHttpServerResponseMapper violationExceptionHttpServerResponseMapper() {
        return (request, exception) -> HttpServerResponseException.of(400, exception.getMessage());
    }

    // One extractor per security scheme. The tag is the marker generated from the scheme NAME
    // in components.securitySchemes — never an ordinal SecurityRequirementTagN (that is 1.x).
    // Returning null means "not authenticated" and the generated interceptor answers 401.
    @Tag(ApiSecurity.BearerAuth.class)
    default HttpServerPrincipalExtractor<String, Principal> bearerHttpServerPrincipalExtractor() {
        return (request, authorization) -> {
            if (authorization == null || !authorization.startsWith("Bearer ")) {
                return null;   // the raw Authorization header is passed through, prefix included
            }
            return new UserPrincipal(authorization.substring("Bearer ".length()));
        };
    }

    @Tag(ApiSecurity.ApiKeyAuth.class)
    default HttpServerPrincipalExtractor<String, Principal> apiKeyHttpServerPrincipalExtractor() {
        return (request, apiKey) -> apiKey == null ? null : new UserPrincipal(apiKey);
    }

    // An oauth2 scheme requires PrincipalWithScopes: the generated interceptor checks
    // principal.scopes().contains("<scope from the contract>") before proceeding.
    @Tag(ApiSecurity.OAuth.class)
    default HttpServerPrincipalExtractor<String, PrincipalWithScopes> oauthHttpServerPrincipalExtractor() {
        return (request, authorization) -> authorization == null
                ? null
                : new UserPrincipal(authorization);
    }
}


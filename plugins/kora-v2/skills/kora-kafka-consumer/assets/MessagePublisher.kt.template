package ${packagePath}.publisher

import io.koraframework.kafka.common.annotation.KafkaPublisher
import io.koraframework.kafka.common.annotation.KafkaPublisher.Topic
import org.apache.kafka.clients.producer.ProducerRecord
import org.apache.kafka.clients.producer.RecordMetadata
import org.apache.kafka.common.header.Headers
import java.util.concurrent.Future

/**
 * Plain-text Kafka publisher — useful next to a consumer for DLQ and read-process-write flows.
 *
 * @KafkaPublisher("<path>") is the producer's own config section (driverProperties, telemetry).
 * @Topic("<path>") points at a section holding `topic` (and optionally `partition`).
 *
 * Return types:
 *   Unit                      fire and wait for the broker ack, throwing KafkaPublishException
 *   RecordMetadata            same, but returns the broker's metadata
 *   Future<RecordMetadata>    hands back the in-flight send
 */
@KafkaPublisher("kafka.producer.${publisherName}")
interface ${publisherName} {

    @Topic("kafka.producer.${publisherName}.${topicName}")
    fun send(value: String)

    @Topic("kafka.producer.${publisherName}.${topicName}")
    fun send(key: String, value: String)

    @Topic("kafka.producer.${publisherName}.${topicName}")
    fun send(key: String, value: String, headers: Headers)

    @Topic("kafka.producer.${publisherName}.${topicName}")
    fun sendWithMeta(value: String): RecordMetadata

    @Topic("kafka.producer.${publisherName}.${topicName}")
    fun sendAsync(value: String): Future<RecordMetadata>

    /**
     * Full control over topic, partition, timestamp and headers. A ProducerRecord parameter
     * carries its own topic, so the function needs no @Topic.
     */
    fun send(record: ProducerRecord<String, String>)
}

 * @Tag(${listenerName}Module.${listenerName}ProcessTag.class)
 * @Component
 * public final class ${listenerName}RebalanceListener implements ConsumerAwareRebalanceListener {
 *     public void onPartitionsRevoked(Consumer<?, ?> c, Collection<TopicPartition> p) { }
 *     public void onPartitionsAssigned(Consumer<?, ?> c, Collection<TopicPartition> p) { }
 *     public void onPartitionsLost(Consumer<?, ?> c, Collection<TopicPartition> p) { }  // never commit here
 * }
 */

package ${package}

import io.koraframework.database.common.annotation.Column
import io.koraframework.database.common.annotation.Embedded
import io.koraframework.database.common.annotation.Id
import io.koraframework.database.common.annotation.Table
import io.koraframework.database.jdbc.annotation.EntityJdbc

/**
 * Entity with a composite primary key for a Kora 2.0 JDBC repository (Kotlin).
 *
 * Pattern:
 * - a nested data class holds the key components;
 * - `@field:Id @field:Embedded` on the parent property flattens them into the parent's columns;
 * - the nested key type does NOT need @EntityJdbc — it is expanded into the parent's mapper;
 * - `@field:Embedded("prefix_")` would prepend a prefix to every nested column name.
 *
 * Use `@field:` throughout: Kora reads the field, not the constructor parameter.
 *
 * Query it with %{id#where} (parameter named `id`) or %{entity#where = @id} (entity parameter);
 * both expand to `${id1_column} = ? AND ${id2_column} = ?`.
 *
 * Matching DDL (give the key columns the SQL type that matches ${id1_type} / ${id2_type}):
 *   CREATE TABLE ${table_name} (
 *       ${id1_column} <key type> NOT NULL,
 *       ${id2_column} <key type> NOT NULL,
 *       name varchar(255) NOT NULL,
 *       quantity integer NOT NULL,
 *       note text,
 *       PRIMARY KEY (${id1_column}, ${id2_column})
 *   );
 */
@EntityJdbc
@Table("${table_name}")
data class ${entity_name}(
    @field:Id @field:Embedded val id: ID,
    val name: String,
    val quantity: Int,
    val note: String? = null
) {
    /** Composite key: both components are part of the primary key. */
    data class ID(
        @field:Column("${id1_column}") val ${id1_field}: ${id1_type},
        @field:Column("${id2_column}") val ${id2_field}: ${id2_type}
    )
}

package ${package}

import io.koraframework.database.common.UpdateCount
import io.koraframework.database.common.annotation.Batch
import io.koraframework.database.common.annotation.Query
import io.koraframework.database.jdbc.JdbcRepository

/**
 * Reusable CRUD base interface for Kora 2.0 JDBC repositories with a single-column key (Kotlin).
 *
 * This interface is NOT annotated with @Repository — only the concrete interface that binds the
 * type arguments is. KSP resolves each macro against the bound entity type.
 *
 * Macro targets inside a generic base:
 * - a function parameter name (`entity`) — used by insert/update/upsert/delete below;
 * - `return` — the function's return type;
 * - a TYPE PARAMETER of this interface (`%{V#table}`) — the only option for a function that takes
 *   neither an entity nor a matching return type, such as findById/deleteById/deleteAll.
 *
 * `%{entity#table}` in a function without an `entity` parameter does not compile:
 * "Query macro target `entity` cannot be resolved".
 *
 * findById/deleteById below assume the key column is literally named `id`. That is the price of
 * putting them on a generic base — the macros cannot render a key-column predicate against a
 * loose value. If an entity names its key differently, override the two functions in the concrete
 * repository with the real column name.
 *
 * Repository contracts are synchronous — `suspend fun` is rejected by the generator.
 *
 * Usage:
 *   @Repository
 *   interface UserRepository : AbstractCrudSingleIdMacrosRepository<Long, User> {
 *
 *       @Query("SELECT %{return#selects} FROM %{return#table} WHERE email = :email")
 *       fun findByEmail(email: String): User?
 *   }
 *
 * @param K id type (Long, UUID, String)
 * @param V entity type — an @EntityJdbc data class with an @Id property of type K
 */
interface AbstractCrudSingleIdMacrosRepository<K, V> : JdbcRepository {

    @Query("SELECT %{return#selects} FROM %{return#table} WHERE id = :id")
    fun findById(id: K): V?

    @Query("SELECT %{return#selects} FROM %{return#table}")
    fun findAll(): List<V>

    @Query("INSERT INTO %{entity#inserts}")
    fun insert(entity: V): UpdateCount

    @Query("INSERT INTO %{entity#inserts}")
    fun insertBatch(@Batch entity: List<V>): UpdateCount

    @Query("UPDATE %{entity#table} SET %{entity#updates} WHERE %{entity#where = @id}")
    fun update(entity: V): UpdateCount

    @Query("UPDATE %{entity#table} SET %{entity#updates} WHERE %{entity#where = @id}")
    fun updateBatch(@Batch entity: List<V>): UpdateCount

    @Query("INSERT INTO %{entity#inserts} ON CONFLICT (%{entity#selects = @id}) DO UPDATE SET %{entity#updates}")
    fun upsert(entity: V): UpdateCount

    @Query("INSERT INTO %{entity#inserts} ON CONFLICT (%{entity#selects = @id}) DO UPDATE SET %{entity#updates}")
    fun upsertBatch(@Batch entity: List<V>): UpdateCount

    @Query("DELETE FROM %{entity#table} WHERE %{entity#where = @id}")
    fun delete(entity: V): UpdateCount

    /** No entity parameter, so the macro targets the type parameter instead. */
    @Query("DELETE FROM %{V#table} WHERE id = :id")
    fun deleteById(id: K): UpdateCount

    @Query("DELETE FROM %{V#table}")
    fun deleteAll(): UpdateCount
}

openapi {
  management {
    # Mandatory: classpath resource paths, no default. Omitting this key fails graph build with
    # "Config expected value, but got null after parsing at path: 'ROOT.openapi.management.files'",
    # even when everything below is disabled. A plain comma-separated string is also accepted.
    # The Kora 1.x key was "file" (singular) and is not read in 2.0.
    files = ["openapi/api.yaml"]

    # Registers the raw-spec route. Default false. Both viewers fetch this route, so leaving it
    # false renders them empty.
    enabled = true

    # Base route. One file => GET /openapi; several files => GET /openapi/{basename}.
    # The Kora 1.x key was "endpoint" and is not read in 2.0.
    path = "/openapi"

    # Response caching: NONE | GZIP | FULL. Default GZIP.
    cache = GZIP

    # Key is exactly "swaggerui" - "swaggerUi" and "swagger-ui" are different keys and are ignored.
    swaggerui {
      enabled = true
      path = "/swagger-ui"        # also registers /swagger-ui/oauth2-redirect
      withCredentials = true      # sends cookies on try-it-out calls
      cache = GZIP

      # Uncomment to override the Swagger UI init options. Setting this key REPLACES the whole
      # default map, so every entry you want to keep must be repeated here.
      # options {
      #   layout = "StandaloneLayout"
      #   validatorUrl = "null"
      #   defaultModelsExpandDepth = "0"
      #   deepLinking = "true"
      #   persistAuthorization = "true"
      #   displayOperationId = "true"
      #   filter = "true"
      # }
    }

    # Scalar replaced RapiDoc in Kora 2.0; a "rapidoc" block is an unknown key and is ignored.
    scalar {
      enabled = true
      path = "/scalar"
      cache = GZIP
    }
  }
}

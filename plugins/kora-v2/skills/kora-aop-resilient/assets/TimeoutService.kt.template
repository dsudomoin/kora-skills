// @Timeout — per-attempt and overall (Kora 2.0).
// The class AND every annotated method must be `open`.
// Replace `com.example.app.resilience` with your package.

package com.example.app.resilience

import io.koraframework.common.annotation.Component
import io.koraframework.resilient.retry.Retry
import io.koraframework.resilient.retry.annotation.RetrySpec
import io.koraframework.resilient.retry.annotation.Retryable
import io.koraframework.resilient.timeout.Timeouter
import io.koraframework.resilient.timeout.annotation.Timeout
import io.koraframework.resilient.timeout.annotation.TimeoutSpec

// NOTE: the runtime contract is Timeouter — `Timeout` is the annotation.
// A leftover @Timeout("report") crashes KSP with
// "ClassCastException: String cannot be cast to KSType" instead of a readable error.
@TimeoutSpec("resilient.timeout.report")
interface ReportTimeouter : Timeouter

// A shared timeout tier: one interface reused everywhere instead of a repeated string.
@TimeoutSpec("resilient.timeout.perAttempt")
interface PerAttemptTimeouter : Timeouter

@RetrySpec("resilient.retry.report")
interface ReportRetry : Retry

@Component
open class ReportService(private val engine: ReportEngine) {

    // Throws TimeoutExhaustedException("Timeout exceeded <duration>") when the deadline passes.
    // A blocking body runs on a per-timeouter VIRTUAL THREAD and is interrupted on expiry.
    @Timeout(ReportTimeouter::class)
    open fun generate(request: ReportRequest): Report = engine.generate(request)

    // For a suspend function the aspect uses kotlinx.coroutines.withTimeout instead of the
    // executor, so cancellation is cooperative and no extra thread is involved.
    @Timeout(ReportTimeouter::class)
    open suspend fun generateAsync(request: ReportRequest): Report = engine.generate(request)

    // PER-ATTEMPT bound: @Retryable listed first (outer), @Timeout last (inner).
    // Worst case ~= (attempts + 1) * duration + the retry delays.
    @Retryable(ReportRetry::class)
    @Timeout(PerAttemptTimeouter::class)
    open fun generateWithPerAttemptTimeout(request: ReportRequest): Report = engine.generate(request)

    // OVERALL budget: @Timeout first (outer), @Retryable last (inner).
    // Keep the budget larger than the whole retry schedule or later attempts never run.
    @Timeout(ReportTimeouter::class)
    @Retryable(ReportRetry::class)
    open fun generateWithOverallBudget(request: ReportRequest): Report = engine.generate(request)
}

// ---------------------------------------------------------------- placeholders

data class ReportRequest(val id: String)

data class Report(val content: String)

@Component
open class ReportEngine {
    open fun generate(request: ReportRequest): Report = Report("report:${request.id}")
}


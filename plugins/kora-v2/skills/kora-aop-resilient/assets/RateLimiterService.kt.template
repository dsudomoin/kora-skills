// @RateLimited — NEW in Kora 2.0, no 1.x equivalent.
// The class AND the annotated method must be `open`.
// Replace `com.example.app.resilience` with your package.

package com.example.app.resilience

import io.koraframework.common.annotation.Component
import io.koraframework.resilient.ratelimiter.RateLimiter
import io.koraframework.resilient.ratelimiter.annotation.RateLimited
import io.koraframework.resilient.ratelimiter.annotation.RateLimiterSpec

// The spec interface IS the permit pool. Every method annotated with THIS class draws from the
// same pool — that is how one quota is shared across call sites. Two spec interfaces on the same
// config path are two independent pools, each with the full allowance.
@RateLimiterSpec("resilient.ratelimiter.notifications")
interface NotificationRateLimiter : RateLimiter

@Component
open class NotificationSender(private val gateway: SmsGateway) {

    // Fails fast with RateLimitExceededException once the window's permits are spent —
    // callers are never queued or blocked. Wrap with @Retryable (listed ABOVE @RateLimited)
    // if a rejected call should wait and try again instead of surfacing the exception.
    @RateLimited(NotificationRateLimiter::class)
    open fun send(notification: Notification) = gateway.send(notification)
}

// Imperative use: the spec interface is a graph component. tryAcquire() returns a boolean
// instead of throwing, which suits batch work that should defer rather than fail.
// There is no RateLimiterManager in Kora 2.0.
@Component
open class BulkNotificationSender(
    private val rateLimiter: NotificationRateLimiter,
    private val gateway: SmsGateway,
    private val deferred: DeferredQueue
) {

    open fun sendAll(batch: List<Notification>) {
        for (notification in batch) {
            if (rateLimiter.tryAcquire()) {
                gateway.send(notification)
            } else {
                deferred.enqueue(notification)
            }
        }
    }
}

// ---------------------------------------------------------------- placeholders

data class Notification(val recipient: String, val text: String)

@Component
open class SmsGateway {
    open fun send(notification: Notification) = Unit
}

@Component
open class DeferredQueue {
    open fun enqueue(notification: Notification) = Unit
}

// Config (HOCON):
//
// resilient.ratelimiter.notifications {
//   limitForPeriod = 100        # REQUIRED — permits per window
//   limitRefreshPeriod = "1s"   # REQUIRED — window length
//   enabled = true              # optional, default true
// }
//
// Fixed window, refilled lazily on the first call after the deadline. Unused permits do not carry
// over, and the window is not wall-clock aligned — a burst straddling a boundary can briefly pass
// up to 2 * limitForPeriod calls. This is a per-process limiter with no shared state.

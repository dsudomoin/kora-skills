//                                       # RING_BUFFER is the closest match to a 1.x sliding window
//   countBased.windowSize = 50          # REQUIRED — was slidingWindowSize in Kora 1.x
//   minimumRequiredCalls = 25           # REQUIRED
//   failureRateThreshold = 30           # REQUIRED — percent, 1..100
//   waitDurationInOpenState = "60s"     # REQUIRED
//   permittedCallsInHalfOpenState = 5   # REQUIRED
// }
//
// Omitting countBased is NOT a config error — the graph fails at startup with
// IllegalArgumentException: CircuitBreaker 'OrderCircuitBreaker' property 'countBased' is not configured

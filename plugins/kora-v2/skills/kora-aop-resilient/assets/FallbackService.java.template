// @Fallback for graceful degradation (Kora 2.0).
// Replace `com.example.app.resilience` with your package.
//
// The `value` attribute was REMOVED in 2.0 — @Fallback(method = "...") is the only form.
// There is no @FallbackSpec, no resilient.fallback.<name> section and no FallbackPredicate;
// filtering is done with the @Fallback.Reason parameter type.

package com.example.app.resilience;

import java.util.Optional;

import io.koraframework.common.annotation.Component;
import io.koraframework.http.client.common.exception.HttpClientResponseException;
import io.koraframework.resilient.fallback.annotation.Fallback;

@Component
public class ProductService {                                           // NOT final

    private final ProductRepository repository;
    private final ProductCache cache;
    private final InventoryClient inventoryClient;

    public ProductService(ProductRepository repository,
                          ProductCache cache,
                          InventoryClient inventoryClient) {
        this.repository = repository;
        this.cache = cache;
        this.inventoryClient = inventoryClient;
    }

    // `method` is a compile-time method reference: "name()" or "name(arg1, arg2)", where each
    // argument is a PARAMETER NAME of this method. It is not an expression language.
    // Every Throwable triggers the fallback unless a @Fallback.Reason parameter narrows it.
    @Fallback(method = "getFromCache(id)")
    public Product getProduct(String id) {
        return repository.findById(id)
            .orElseThrow(() -> new ProductNotFoundException(id));
    }

    // Fallback method rules:
    //   1. same class as the annotated method
    //   2. parameters == exactly the referenced arguments (+ at most one @Fallback.Reason)
    //   3. return type assignable to the annotated method's return type
    //   4. protected or public — a private method is unreachable from the generated proxy
    protected Product getFromCache(String id) {
        return cache.get(id);
    }

    // The @Fallback.Reason parameter is NOT named in the reference string — the processor
    // appends it. Here the reference stays "unknownStock(sku)" even though the fallback method
    // declares two parameters.
    //
    // @Fallback.Reason both receives the triggering exception AND acts as a filter: the generated
    // code emits `if (!(_e instanceof RuntimeException)) throw _e;` before calling the fallback.
    //
    // In Java the permitted reason type is fixed by the annotated method's throws clause:
    //   no throws        -> RuntimeException
    //   throws <checked> -> Exception
    //   throws Throwable -> Throwable
    // A mismatch fails the build with "@Fallback.Reason parameter ... has incompatible type".
    @Fallback(method = "unknownStock(sku)")
    public Stock checkStock(String sku) {
        return inventoryClient.lookup(sku);
    }

    // Degrade only on an infrastructure failure; let a domain exception reach the caller.
    protected Stock unknownStock(String sku, @Fallback.Reason RuntimeException reason) {
        if (!(reason instanceof HttpClientResponseException)) {
            throw reason;
        }
        return Stock.UNKNOWN;
    }
}

// ---------------------------------------------------------------- placeholders

record Product(String id, String name) {}

enum Stock { IN_STOCK, OUT_OF_STOCK, UNKNOWN }

class ProductNotFoundException extends RuntimeException {
    ProductNotFoundException(String id) {
        super("Product not found: " + id);
    }
}

@Component
class ProductRepository {
    Optional<Product> findById(String id) {
        return Optional.empty();
    }
}

@Component
class ProductCache {
    Product get(String id) {
        return new Product(id, "unknown");
    }
}

@Component
class InventoryClient {
    Stock lookup(String sku) {
        return Stock.IN_STOCK;
    }
}

// Placement matters. @Fallback belongs FIRST (outermost) in a stack so it catches
// CallNotPermittedException, RetryExhaustedException and TimeoutExhaustedException too:
//
//   @Fallback(method = "chargeFallback(request)")
//   @CircuitBreakable(PaymentCircuitBreaker.class)
//   @Retryable(PaymentRetry.class)
//   @Timeout(PaymentTimeouter.class)
//
// Listing @Fallback LAST makes it innermost: it would swallow the failure before the circuit
// breaker records it, and the breaker would never open.
//
// The only fallback configuration in Kora 2.0 is telemetry:
//
// resilient.telemetry.fallback { logging.enabled = true, metrics.enabled = true }

package ${packagePath};

import io.koraframework.common.annotation.Component;
import io.koraframework.common.annotation.Tag;

/**
 * One of several implementations of {@code ${InterfaceName}}, selected by tag.
 *
 * <p>Import {@code Tag} from <b>io.koraframework.common.annotation</b> — {@code io.koraframework.common}
 * holds {@code Configurer}, {@code Either}, {@code Principal} and {@code PromisedProxy}, not the DI
 * annotations.
 */
@Tag(${TagClass}.class)
@Component
public final class ${ComponentName} implements ${InterfaceName} {

    private final ${DependencyType} ${dependencyName};

    public ${ComponentName}(${DependencyType} ${dependencyName}) {
        this.${dependencyName} = ${dependencyName};
    }

    @Override
    public void ${methodName}() {
        // implementation
    }
}


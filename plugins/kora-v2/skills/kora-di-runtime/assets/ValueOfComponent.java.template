package ${packagePath};

import io.koraframework.application.graph.ValueOf;
import io.koraframework.common.annotation.Component;

/**
 * Depending on a component without being rebuilt when it refreshes.
 *
 * <p>The whole interface is:
 * <pre>{@code
 * public interface ValueOf<T> {
 *     T get();
 *     default <Q> ValueOf<Q> map(Function<T, Q> mapper);
 *     default ValueOf<Optional<T>> optional();
 * }
 * }</pre>
 * There is <b>no {@code refresh()}</b> on {@code ValueOf} — refreshing the graph is
 * {@code RefreshableGraph.refresh(Node)}.
 *
 * <p>Two guarantees: {@code get()} always returns the current instance of that node, and this
 * component is <b>not</b> recreated when the wrapped component is refreshed. A direct dependency
 * would be.
 *
 * <p>Use it when rebuilding this component is expensive or disruptive — an open socket, a warm
 * cache, a connection pool — or when the latest value is needed per call rather than a snapshot
 * taken at construction. Do not use it as a general laziness knob: a direct dependency is cheaper to
 * read and gives the container a real ordering edge.
 */
@Component
public final class ${ComponentName} {

    private final ValueOf<${DependencyType}> ${dependencyName};

    public ${ComponentName}(ValueOf<${DependencyType}> ${dependencyName}) {
        this.${dependencyName} = ${dependencyName};
    }

    public void ${methodName}() {
        var current = ${dependencyName}.get();
        // use `current` — never cache it in a field, that would defeat the point
    }
}

// ---------------------------------------------------------------------------
// Variants
// ---------------------------------------------------------------------------
//
// Optional AND refresh-isolated — here the component itself may be absent, so the field is null,
// not the result of get(). @Nullable is org.jspecify.annotations.Nullable and is type-use.
//
//     public MetricsReporter(@Nullable ValueOf<MeterRegistry> registry) {
//         this.registry = registry;
//     }
//
// PromiseOf<T> is the weaker handle: get() returns Optional<T>, so the component may be unresolved.
// It is what the processor generates (PromisedProxy) to break a dependency cycle. For an ordinary
// cycle between two of your own components, extracting the shared piece into a third component
// reads better than either wrapper.

package ${packagePath}

import io.koraframework.common.annotation.Component
import io.koraframework.common.annotation.Tag

/**
 * One of several implementations of `${InterfaceName}`, selected by tag.
 *
 * Import `Tag` from **io.koraframework.common.annotation** — `io.koraframework.common` holds
 * `Configurer`, `Either`, `Principal` and `PromisedProxy`, not the DI annotations.
 */
@Tag(${TagClass}::class)
@Component
class ${ComponentName}(
    private val ${dependencyName}: ${DependencyType}
) : ${InterfaceName} {

    override fun ${methodName}() {
        // implementation
    }
}


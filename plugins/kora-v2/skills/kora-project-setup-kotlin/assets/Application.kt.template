package com.example

import io.koraframework.application.graph.KoraApplication
import io.koraframework.common.annotation.KoraApp
import io.koraframework.config.hocon.HoconConfigModule
import io.koraframework.http.server.undertow.UndertowPublicHttpServerModule
import io.koraframework.json.common.JsonModule
import io.koraframework.logging.logback.LogbackModule

// @KoraApp marks the application graph root. Each plugged-in Kora capability
// is added as an interface the application extends (the *Module interfaces).
// UndertowPublicHttpServerModule also brings the system server that serves
// /system/readiness, /system/liveness and /metrics on httpServer.system.port.
@KoraApp
interface Application :
    HoconConfigModule,
    JsonModule,
    LogbackModule,
    UndertowPublicHttpServerModule

// ApplicationGraph is generated by the Kora symbol processors at compile time:
// <@KoraApp interface name> + "Graph", in the same package.
fun main() {
    KoraApplication.run { ApplicationGraph.graph() }
}

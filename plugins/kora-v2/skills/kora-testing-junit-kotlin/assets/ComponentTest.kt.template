package ${package}

import io.mockk.every
import io.mockk.impl.annotations.MockK
import io.mockk.verify
import org.junit.jupiter.api.Assertions.assertEquals
import org.junit.jupiter.api.Assertions.assertNotNull
import org.junit.jupiter.api.BeforeEach
import org.junit.jupiter.api.Test
import io.koraframework.test.extension.junit5.KoraAppTest
import io.koraframework.test.extension.junit5.TestComponent

// Component test: a real ${componentName} from the graph with a mocked dependency.
//
// @field:MockK creates the mock; @TestComponent registers it in the graph in place of the real
// ${dependencyName} and injects the same instance into every component that depends on it.
//
//   - use @field:MockK, not bare @MockK: the bare form annotates the Kotlin property and is only
//     discovered when kotlin-reflect is on the test classpath, otherwise the REAL component is
//     injected with no error at all;
//   - do NOT add a "= mockk()" initializer — the annotation builds the mock;
//   - do NOT attach @ExtendWith(MockKExtension::class) — @KoraAppTest owns creation, injection
//     and reset;
//   - use every/verify, never coEvery/coVerify: Kora 2.0 contracts are synchronous.
@KoraAppTest(Application::class)
class ${componentName}Test {

    @field:MockK
    @TestComponent
    lateinit var ${dependencyVarName}: ${dependencyName}

    @TestComponent
    lateinit var ${componentVarName}: ${componentName}

    @BeforeEach
    fun setup() {
        every { ${dependencyVarName}.someMethod(any()) } returns someValue
    }

    @Test
    fun `should do something`() {
        val result = ${componentVarName}.doSomething()

        assertNotNull(result)
        assertEquals(expectedValue, result)
        verify { ${dependencyVarName}.someMethod(any()) }
    }
}

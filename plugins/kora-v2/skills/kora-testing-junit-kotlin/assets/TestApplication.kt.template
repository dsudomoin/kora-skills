package ${package}

import io.koraframework.common.annotation.KoraApp
import io.koraframework.common.annotation.Root
import io.koraframework.common.annotation.Tag
import io.koraframework.database.common.annotation.Query
import io.koraframework.database.common.annotation.Repository
import io.koraframework.database.jdbc.JdbcRepository

// TestApplication extends the production @KoraApp and adds test-only components — for example a
// cleanup/inspection repository the production graph has no reason to declare. Point the test at it
// with @KoraAppTest(TestApplication::class).
//
// Kora prunes the graph at COMPILE time, so anything nothing else depends on must be reachable from
// a @Root or @TestComponent will not find it. Two equivalent shapes are in use upstream: a @Root
// anchor method (below), or @Root + @Component directly on each test-only component.
//
// Build wiring — two independent settings, often in two different modules:
//
//   this module (its src/test declares a @KoraApp):
//     dependencies { kspTest("io.koraframework:symbol-processors:${property("koraVersion")}") }
//
//   the module that compiles the production @KoraApp — only when that is a DIFFERENT Gradle module:
//     ksp { arg("kora.app.submodule.enabled", "true") }
//
//   tasks.test {
//       exclude("**/\$*")          // generated classes start with $ and confuse JUnit discovery
//       failOnNoDiscoveredTests = false
//   }
//
// Missing either one produces:
//   Cannot find generated Kora application graph for: ...TestApplication
//
// kspTest is required ONLY because src/test declares its own @KoraApp. An ordinary
// @KoraAppTest(Application::class) test that points at a graph compiled in src/main does NOT need
// it — never add or remove kspTest by blanket replacement.
@KoraApp
interface TestApplication : Application {

    @Repository
    interface Test${entityName}Repository : JdbcRepository {

        @Query("SELECT %{return#selects} FROM %{return#table}")
        fun findAll(): List<${entityDao}>

        @Query("DELETE FROM ${tableName}")
        fun deleteAll()
    }

    // @Root anchor so the test-only repository is not pruned from the graph.
    @Tag(TestApplication::class)
    @Root
    fun testRoot(ignored: Test${entityName}Repository): String = "test-root"
}

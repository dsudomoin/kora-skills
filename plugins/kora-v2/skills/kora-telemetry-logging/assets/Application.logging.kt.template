 * module (HoconConfigModule or YamlConfigModule) must be in the graph as well.
 */
@KoraApp
interface Application : LogbackModule, HoconConfigModule {
    companion object {
        @JvmStatic
        fun main(args: Array<String>) {
            KoraApplication.run(ApplicationGraph::graph)

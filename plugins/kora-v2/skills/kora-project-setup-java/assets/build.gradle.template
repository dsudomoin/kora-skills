plugins {
    id "java"
    id "application"
}

java {
    toolchain {
        // Kora 2.0 artifacts are compiled for JVM 25 - this is a floor, not a preference.
        // The JDK that runs Gradle itself must also be 25+ (see references/build-gradle-reference.md).
        languageVersion = JavaLanguageVersion.of(25)
        vendor = JvmVendorSpec.ADOPTIUM
    }
}

repositories {
    mavenCentral()
}

// The annotation-processor classpath is separate from the application classpath,
// so it needs the BOM explicitly. Every configuration below extends koraBom.
configurations {
    koraBom
    annotationProcessor.extendsFrom(koraBom)
    compileOnly.extendsFrom(koraBom)
    implementation.extendsFrom(koraBom)
    testImplementation.extendsFrom(koraBom)
    testAnnotationProcessor.extendsFrom(koraBom)
}

dependencies {
    // BOM declared once; pins every io.koraframework:* artifact. Do not version them.
    koraBom platform("io.koraframework:kora-bom:$koraVersion")

    // Mandatory: generates the graph, controllers, JSON readers/writers, aspects.
    annotationProcessor "io.koraframework:annotation-processors"

    // Each module backs one *Module in the @KoraApp interface.
    implementation "io.koraframework:http-server-undertow"
    implementation "io.koraframework:config-hocon"
    implementation "io.koraframework:json-common"
    implementation "io.koraframework:logging-logback"

    // Required so the @KoraAppTest graph is generated for the test source set.
    testAnnotationProcessor "io.koraframework:annotation-processors"

    testImplementation platform("org.junit:junit-bom:$junitVersion")
    testImplementation "org.junit.jupiter:junit-jupiter"
    testImplementation "io.koraframework:test-junit5"
}

application {
    applicationName = "application"
    mainClass = "com.example.Application"
    applicationDefaultJvmArgs = ["-Dfile.encoding=UTF-8"]
}

distTar {
    archiveFileName = "application.tar"
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = "UTF-8"
    options.incremental = true
    options.fork = false
}

test {
    jvmArgs += [
            "-XX:+TieredCompilation",
            "-XX:TieredStopAtLevel=1",
    ]
    useJUnitPlatform()
    testLogging {
        showStandardStreams = true
        events("passed", "skipped", "failed")
        exceptionFormat = "full"
    }
}

package com.example.app.cache;

import com.example.app.dto.OrderDto;
import io.koraframework.cache.annotation.Cache;
import io.koraframework.cache.caffeine.CaffeineCache;

import java.util.UUID;

@Cache("orders.composite.cache")
public interface OrderCompositeCache extends CaffeineCache<OrderCompositeCache.Key, OrderDto> {

    // A record key needs no mapper: the processor emits `new Key(tenantId, orderId)` because the
    // public canonical constructor matches the selected method parameters, in order.
    record Key(UUID tenantId, UUID orderId) {}
}



// ==== file: OrderQueryService.java — the cache used imperatively
// ============================================================================

package com.example.app.service;

import com.example.app.cache.OrderCache;
import com.example.app.dto.OrderDto;
import io.koraframework.common.annotation.Component;

import java.util.UUID;

// No AOP here, so this class may be final.
@Component
public final class OrderQueryService {

    private final OrderCache cache;
    private final OrderRepository repository;

    public OrderQueryService(OrderCache cache, OrderRepository repository) {
        this.cache = cache;
        this.repository = repository;
    }

    // Equivalent to @Cacheable on a single synchronous cache, and atomic per key on Caffeine.
    public OrderDto getOrLoad(UUID id) {
        return cache.computeIfAbsent(id, repository::find);
    }

    // The key only exists after the body has run, so @CachePut cannot express this.
    public OrderDto create(com.example.app.dto.OrderRequest request) {
        var created = repository.insert(request);
        cache.put(created.id(), created);
        return created;
    }

    public void evict(UUID id) {
        cache.invalidate(id);           // put/get/invalidate silently ignore null keys and values
    }
}



package com.example.app.cache;

import com.example.app.dto.OrderDto;
import io.koraframework.cache.annotation.Cache;
import io.koraframework.cache.caffeine.CaffeineCache;

import java.util.UUID;

// @Cache("<config path>") must sit on an INTERFACE that extends exactly one of
// CaffeineCache<K, V> or RedisCache<K, V>. The processor generates $OrderCache_Impl and
// $OrderCache_Module; the module is discovered automatically — do not list it on @KoraApp.
@Cache("orders.cache")
public interface OrderCache extends CaffeineCache<UUID, OrderDto> {}



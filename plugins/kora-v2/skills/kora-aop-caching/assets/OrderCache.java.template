package com.example.app.cache;

import com.example.app.dto.OrderDto;
import com.example.app.service.OrderRepository;
import io.koraframework.cache.LoadableCache;
import io.koraframework.common.annotation.Module;

import java.util.UUID;

@Module
public interface OrderLoadableCacheModule {

    // asLoadableSimple takes Function<K, V>; asLoadable takes Function<Collection<K>, Map<K, V>>.
    default LoadableCache<UUID, OrderDto> orderLoadableCache(OrderCache cache, OrderRepository repository) {
        return cache.asLoadableSimple(repository::find);
    }
}



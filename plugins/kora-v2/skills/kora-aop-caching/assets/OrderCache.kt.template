//
// Requires: io.koraframework:cache-caffeine (and cache-redis-lettuce + json-common for the Redis
// variant) plus ksp("io.koraframework:symbol-processors").
//
// KOTLIN RULE: a class carrying cache annotations must be `open`, and every annotated function must
// be `open` too. Otherwise KSP fails with
//   AOP aspect cannot be applied to class '...' because the class is not open.
//   AOP aspect cannot be applied to function '...' because the function is not open.

// ============================================================================
// ==== file: OrderCache.kt — typed Caffeine cache with a simple key
// ============================================================================

package com.example.app.cache

import com.example.app.dto.OrderDto
import io.koraframework.cache.annotation.Cache
import io.koraframework.cache.caffeine.CaffeineCache
import java.util.UUID

// @Cache("<config path>") must sit on an INTERFACE extending exactly one of
// CaffeineCache<K, V> or RedisCache<K, V>. KSP generates $OrderCache_Impl and $OrderCache_Module;
// the module is discovered automatically — do not list it on @KoraApp.
@Cache("orders.cache")
interface OrderCache : CaffeineCache<UUID, OrderDto>


// ============================================================================
// ==== file: OrderCompositeCache.kt — composite key from a data class
// ============================================================================

package com.example.app.cache

import com.example.app.dto.OrderDto
import io.koraframework.cache.annotation.Cache
import io.koraframework.cache.caffeine.CaffeineCache
import java.util.UUID

@Cache("orders.composite.cache")
interface OrderCompositeCache : CaffeineCache<OrderCompositeCache.Key, OrderDto> {

    // A data class key needs no mapper: the processor emits `Key(tenantId, orderId)` because the
    // primary constructor matches the selected method parameters, in order.
    data class Key(val tenantId: UUID, val orderId: UUID)
}



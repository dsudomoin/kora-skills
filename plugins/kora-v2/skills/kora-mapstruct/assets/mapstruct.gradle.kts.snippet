// Kora 2.0 — mapper wiring for a KOTLIN module (Kotlin DSL).
//
// kapt is NOT the Kora 2.0 path. MapStruct ships only a javac annotation processor, KSP does not
// run javac processors, and the 2.0 migration deleted every kapt line from the Kora examples.
// Kotlin maps with Konvert, whose processor IS a KSP processor.
//
// `konvert-ksp-extension` and `mapstruct-ksp-extension` are already api dependencies of
// `io.koraframework:symbol-processors`. Never declare either by hand.

// gradle.properties:
//   koraVersion=2.0.0.RC1

plugins {
    kotlin("jvm") version "2.4.10"
    id("com.google.devtools.ksp") version "2.3.11"
}

repositories {
    mavenCentral()
}

kotlin {
    jvmToolchain {
        languageVersion.set(JavaLanguageVersion.of(25))
        vendor.set(JvmVendorSpec.ADOPTIUM)
    }
}

dependencies {
    // Kotlin puts the BOM straight on implementation — no koraBom configuration, no extendsFrom.
    implementation(platform("io.koraframework:kora-bom:${property("koraVersion")}"))

    // The BOM is not applied to the ksp configuration, so this one line carries a version.
    ksp("io.koraframework:symbol-processors:${property("koraVersion")}")

    // Konvert's KSP processor — generates `object <Name>Impl`.
    ksp("io.mcarle:konvert:4.5.1")

    // @Konverter on the COMPILE classpath is mandatory: Kora's extension factory resolves
    // io.mcarle.konvert.api.Konverter and disables itself when the type is absent.
    implementation("io.mcarle:konvert-api:4.5.1")

    kspTest("io.koraframework:symbol-processors:${property("koraVersion")}")
}

// If a code generator must run before KSP (OpenAPI, protobuf), order it explicitly:
// tasks.matching { it.name.startsWith("ksp") }.configureEach {
//     dependsOn(openApiGenerateHttpServer)
// }

// ---------------------------------------------------------------------------
// Using MapStruct from a Kotlin Kora app — the ONE supported route
// ---------------------------------------------------------------------------
// `mapstruct-ksp-extension` never generates anything: it resolves an existing `<Name>Impl` and
// binds its constructor. So the implementation has to arrive from somewhere else — in practice a
// JAVA module compiled with the MapStruct processor, or a published jar.
//
//   :mappers  (Java)    @Mapper FooMapper
//                       annotationProcessor "org.mapstruct:mapstruct-processor:1.6.3"
//                       api "org.mapstruct:mapstruct:1.6.3"        -> produces FooMapperImpl
//
//   :app      (Kotlin)  dependencies {
//                           implementation(project(":mappers"))    // brings mapstruct transitively via api
//                           ksp("io.koraframework:symbol-processors:${property("koraVersion")}")
//                       }
//                       // constructor-injects FooMapper; mapstruct-ksp-extension binds FooMapperImpl
//
// Reach for this only to reuse an existing MapStruct mapper. For new Kotlin code, use Konvert.

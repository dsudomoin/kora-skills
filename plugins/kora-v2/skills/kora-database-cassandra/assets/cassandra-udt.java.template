package ${package};

import io.koraframework.database.cassandra.annotation.UDT;
import io.koraframework.database.common.annotation.Column;

/*
 * TEMPLATE NOTES — delete this block after copying.
 *
 * @UDT has NO attributes — there is no @UDT("address"). The generated mappers read the
 * user-defined type off the bound statement's own metadata (stmt.getType(index)) and address
 * fields BY NAME, so the CQL type may be called anything as long as the field names match.
 *
 * Generated for this type:
 *   $<Udt>_CassandraRowColumnMapper             read a FROZEN<...> column
 *   $<Udt>_List_CassandraRowColumnMapper        read a LIST<FROZEN<...>> column
 *   $<Udt>_CassandraParameterColumnMapper       write a FROZEN<...> column
 *   $<Udt>_List_CassandraParameterColumnMapper  write a LIST<FROZEN<...>> column
 * You never reference these names; the Kora extension wires them in.
 *
 * @UDT is valid on records and Java bean-like classes only.
 *
 * CQL:
 *   CREATE TYPE IF NOT EXISTS ${udt_name} (street TEXT, city TEXT, zip_code TEXT);
 */
@UDT
public record ${udt_name}(
    @Column("street") String street,
    @Column("city") String city,
    @Column("zip_code") String zipCode
) {}

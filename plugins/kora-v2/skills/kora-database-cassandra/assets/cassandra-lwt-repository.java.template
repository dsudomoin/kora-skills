package ${package};

import io.koraframework.database.cassandra.CassandraRepository;
import io.koraframework.database.cassandra.annotation.CassandraProfile;
import io.koraframework.database.common.annotation.Query;
import io.koraframework.database.common.annotation.Repository;
import org.jspecify.annotations.Nullable;

/*
 * TEMPLATE NOTES — delete this block after copying.
 *
 * Cassandra has NO transactions. CassandraExecutor exposes no inTx and there is no analogue of
 * JdbcExecutor.inTx(...). IF / IF NOT EXISTS is a lightweight transaction: a Paxos-backed
 * compare-and-set scoped to a SINGLE PARTITION.
 *
 * - Cassandra returns an LWT result whose first column is the [applied] flag, so a boolean
 *   return maps straight through the default CassandraRowMapper<Boolean>.
 * - Return a @Nullable entity instead when you need the row that lost the race — the driver
 *   returns the current values alongside [applied] = false.
 * - LWT uses the SERIAL consistency level, configured separately from the regular one:
 *       cassandra.basic.request.serialConsistency = "LOCAL_SERIAL"
 *   SERIAL spans all datacenters; LOCAL_SERIAL stays in the local DC.
 * - LWT costs roughly four round trips. Do not use it as the default write path, and give it its
 *   own driver profile when its timeout should differ (see @CassandraProfile below).
 */
@Repository
public interface ${repository_name} extends CassandraRepository {

    @Query("INSERT INTO ${table_name}(id, field1, field2) VALUES (:entity.id, :entity.field1, :entity.field2) IF NOT EXISTS")
    boolean insertIfNotExists(${entity_name} entity);

    @Query("UPDATE ${table_name} SET field1 = :field1 WHERE id = :id IF field1 = :oldField1")
    boolean updateIfField1Matches(${id_type} id, String field1, String oldField1);

    @Query("DELETE FROM ${table_name} WHERE id = :id IF field1 = :oldField1")
    boolean deleteIfField1Matches(${id_type} id, String oldField1);

    @CassandraProfile("lwt")
    @Query("UPDATE ${table_name} SET field1 = :field1 WHERE id = :id IF EXISTS")
    boolean updateIfExists(${id_type} id, String field1);

    @Query("INSERT INTO ${table_name}(id, field1, field2) VALUES (:entity.id, :entity.field1, :entity.field2)")
    void insert(${entity_name} entity);

    @Query("SELECT * FROM ${table_name} WHERE id = :id")
    @Nullable
    ${entity_name} findById(${id_type} id);
}

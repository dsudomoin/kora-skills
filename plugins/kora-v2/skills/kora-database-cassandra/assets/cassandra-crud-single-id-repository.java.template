package ${package};

import io.koraframework.database.cassandra.CassandraRepository;
import io.koraframework.database.common.annotation.Batch;
import io.koraframework.database.common.annotation.Query;
import io.koraframework.database.common.annotation.Repository;
import org.jspecify.annotations.Nullable;

import java.util.List;

/*
 * TEMPLATE NOTES — delete this block after copying.
 *
 * - Extending CassandraRepository is what selects the Cassandra generator; without it the build
 *   fails with "@Repository type doesn't extend any supported repository interface."
 * - Entity parameters bind per column through the dotted accessor :entity.field. A bare :id
 *   resolves only when "id" is itself a method parameter.
 * - Every method parameter must appear in the CQL, or the build fails with
 *   "Query parameter is unused: <name>".
 * - Use @Nullable (JSpecify) for a possibly-absent single row; Optional<T> also works in Java.
 * - @Batch takes a List<T> and one SINGLE-ROW statement; the generator builds a
 *   BatchStatement with DefaultBatchType.UNLOGGED. A batch method returns void — it produces
 *   no mapped result. Batch across partitions is a Cassandra anti-pattern.
 * - IF NOT EXISTS / IF is a lightweight transaction, NOT a transaction: boolean reads the
 *   [applied] flag, which Cassandra returns as the first column of an LWT result.
 * - Cassandra has no transactions and CassandraExecutor has no inTx.
 */
@Repository
public interface ${repository_name} extends CassandraRepository {

    @Query("SELECT * FROM ${table_name} WHERE id = :id")
    @Nullable
    ${entity_name} findById(${id_type} id);

    @Query("SELECT * FROM ${table_name}")
    List<${entity_name}> findAll();

    @Query("INSERT INTO ${table_name}(id, field1, field2, field3) VALUES (:entity.id, :entity.field1, :entity.field2, :entity.field3)")
    void insert(${entity_name} entity);

    @Query("INSERT INTO ${table_name}(id, field1, field2, field3) VALUES (:entity.id, :entity.field1, :entity.field2, :entity.field3)")
    void insertBatch(@Batch List<${entity_name}> entity);

    @Query("INSERT INTO ${table_name}(id, field1, field2, field3) VALUES (:entity.id, :entity.field1, :entity.field2, :entity.field3) IF NOT EXISTS")
    boolean insertIfNotExists(${entity_name} entity);

    @Query("UPDATE ${table_name} SET field1 = :entity.field1, field2 = :entity.field2, field3 = :entity.field3 WHERE id = :entity.id")
    void update(${entity_name} entity);

    @Query("UPDATE ${table_name} SET field1 = :entity.field1, field2 = :entity.field2, field3 = :entity.field3 WHERE id = :entity.id")
    void updateBatch(@Batch List<${entity_name}> entity);

    @Query("DELETE FROM ${table_name} WHERE id = :id")
    void deleteById(${id_type} id);

    @Query("TRUNCATE ${table_name}")
    void deleteAll();
}

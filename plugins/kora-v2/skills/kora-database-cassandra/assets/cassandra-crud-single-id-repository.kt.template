package ${package}

import io.koraframework.database.cassandra.CassandraRepository
import io.koraframework.database.common.annotation.Batch
import io.koraframework.database.common.annotation.Query
import io.koraframework.database.common.annotation.Repository

/*
 * TEMPLATE NOTES — delete this block after copying.
 *
 * - Kotlin Cassandra repositories are SYNCHRONOUS ONLY. suspend is rejected by the KSP
 *   repository builder with "Suspend methods are not supported by the repository generator.",
 *   and Flow<T> is not a supported return type. Return T?, List<T> or Unit.
 * - Nullability is the Kotlin type: T? for a possibly-absent row. Optional<T> has no Kotlin
 *   branch in the generator.
 * - Entity parameters bind per column through the dotted accessor :entity.field.
 * - Every function parameter must appear in the CQL, or the build fails with
 *   "Query parameter is unused: <name>".
 * - @Batch takes a List<T> and one SINGLE-ROW statement; the generator builds a
 *   BatchStatement with DefaultBatchType.UNLOGGED and the function returns Unit.
 * - IF NOT EXISTS / IF is a lightweight transaction, NOT a transaction: Boolean reads the
 *   [applied] flag. Cassandra has no transactions and CassandraExecutor has no inTx.
 */
@Repository
interface ${repository_name} : CassandraRepository {

    @Query("SELECT * FROM ${table_name} WHERE id = :id")
    fun findById(id: ${id_type}): ${entity_name}?

    @Query("SELECT * FROM ${table_name}")
    fun findAll(): List<${entity_name}>

    @Query("INSERT INTO ${table_name}(id, field1, field2, field3) VALUES (:entity.id, :entity.field1, :entity.field2, :entity.field3)")
    fun insert(entity: ${entity_name})

    @Query("INSERT INTO ${table_name}(id, field1, field2, field3) VALUES (:entity.id, :entity.field1, :entity.field2, :entity.field3)")
    fun insertBatch(@Batch entity: List<${entity_name}>)

    @Query("INSERT INTO ${table_name}(id, field1, field2, field3) VALUES (:entity.id, :entity.field1, :entity.field2, :entity.field3) IF NOT EXISTS")
    fun insertIfNotExists(entity: ${entity_name}): Boolean

    @Query("UPDATE ${table_name} SET field1 = :entity.field1, field2 = :entity.field2, field3 = :entity.field3 WHERE id = :entity.id")
    fun update(entity: ${entity_name})

    @Query("UPDATE ${table_name} SET field1 = :entity.field1, field2 = :entity.field2, field3 = :entity.field3 WHERE id = :entity.id")
    fun updateBatch(@Batch entity: List<${entity_name}>)

    @Query("DELETE FROM ${table_name} WHERE id = :id")
    fun deleteById(id: ${id_type})

    @Query("TRUNCATE ${table_name}")
    fun deleteAll()
}

package ${package}

import io.koraframework.database.cassandra.CassandraRepository
import io.koraframework.database.cassandra.annotation.CassandraProfile
import io.koraframework.database.common.annotation.Query
import io.koraframework.database.common.annotation.Repository

/*
 * TEMPLATE NOTES — delete this block after copying.
 *
 * Cassandra has NO transactions. CassandraExecutor exposes no inTx. IF / IF NOT EXISTS is a
 * lightweight transaction: a Paxos-backed compare-and-set scoped to a SINGLE PARTITION.
 *
 * - Boolean reads the [applied] flag, which Cassandra returns as the first column of an LWT
 *   result.
 * - Return a nullable entity instead when you need the row that lost the race.
 * - LWT uses the SERIAL consistency level, configured separately:
 *       cassandra.basic.request.serialConsistency = "LOCAL_SERIAL"
 * - LWT costs roughly four round trips. Do not use it as the default write path.
 * - Synchronous only: no suspend, no Flow.
 */
@Repository
interface ${repository_name} : CassandraRepository {

    @Query("INSERT INTO ${table_name}(id, field1, field2) VALUES (:entity.id, :entity.field1, :entity.field2) IF NOT EXISTS")
    fun insertIfNotExists(entity: ${entity_name}): Boolean

    @Query("UPDATE ${table_name} SET field1 = :field1 WHERE id = :id IF field1 = :oldField1")
    fun updateIfField1Matches(id: ${id_type}, field1: String, oldField1: String): Boolean

    @Query("DELETE FROM ${table_name} WHERE id = :id IF field1 = :oldField1")
    fun deleteIfField1Matches(id: ${id_type}, oldField1: String): Boolean

    @CassandraProfile("lwt")
    @Query("UPDATE ${table_name} SET field1 = :field1 WHERE id = :id IF EXISTS")
    fun updateIfExists(id: ${id_type}, field1: String): Boolean

    @Query("INSERT INTO ${table_name}(id, field1, field2) VALUES (:entity.id, :entity.field1, :entity.field2)")
    fun insert(entity: ${entity_name})

    @Query("SELECT * FROM ${table_name} WHERE id = :id")
    fun findById(id: ${id_type}): ${entity_name}?
}

package com.example.controller;

import io.koraframework.common.annotation.Component;
import io.koraframework.http.common.HttpMethod;
import io.koraframework.http.common.HttpResponseEntity;
import io.koraframework.http.common.annotation.HttpRoute;
import io.koraframework.http.common.annotation.Path;
import io.koraframework.http.common.annotation.Query;
import io.koraframework.http.common.header.HttpHeaders;
import io.koraframework.http.server.common.annotation.HttpController;
import io.koraframework.http.server.common.response.HttpServerResponse;
import io.koraframework.http.server.common.response.HttpServerResponseException;
import io.koraframework.json.common.annotation.Json;
import org.jspecify.annotations.Nullable;

import java.util.List;
import java.util.Optional;

/**
 * CRUD controller template — Kora 2.0.
 *
 * Demonstrates:
 * - @HttpController with no prefix; each @HttpRoute carries its full path
 *   (@HttpController("/users") would prepend a shared prefix instead)
 * - @HttpRoute with an HttpMethod constant and a path
 * - @Path / @Query binding, with JSpecify @Nullable + a boxed type for optional values
 * - @Json on the method and on the body parameter
 * - HttpResponseEntity for a body with a custom status and headers
 * - void for an empty 200, HttpServerResponse for an explicit 204
 * - HttpServerResponseException to short-circuit with a status code
 *
 * Requires: io.koraframework:http-server-undertow, io.koraframework:json-common,
 * and the @KoraApp interface extending UndertowPublicHttpServerModule + JsonModule.
 */
@Component
@HttpController
public final class UserController {

    private final UserService userService;

    public UserController(UserService userService) {
        this.userService = userService;
    }

    @HttpRoute(method = HttpMethod.GET, path = "/users/{userId}")
    @Json
    public UserResponse getUser(@Path String userId) {
        return userService.findById(userId)
                .orElseThrow(() -> HttpServerResponseException.of(404, "User not found: " + userId));
    }

    @HttpRoute(method = HttpMethod.GET, path = "/users")
    @Json
    public List<UserResponse> listUsers(@Nullable @Query Integer page,
                                        @Nullable @Query Integer size) {
        return userService.findAll(page == null ? 0 : page, size == null ? 10 : size);
    }

    @HttpRoute(method = HttpMethod.POST, path = "/users")
    @Json
    public HttpResponseEntity<UserResponse> createUser(@Json UserRequest request) {
        UserResponse created = userService.create(request);
        return HttpResponseEntity.of(201, HttpHeaders.of("Location", "/users/" + created.id()), created);
    }

    @HttpRoute(method = HttpMethod.PUT, path = "/users/{userId}")
    @Json
    public UserResponse updateUser(@Path String userId, @Json UserRequest request) {
        return userService.update(userId, request)
                .orElseThrow(() -> HttpServerResponseException.of(404, "User not found: " + userId));
    }

    @HttpRoute(method = HttpMethod.DELETE, path = "/users/{userId}")
    public HttpServerResponse deleteUser(@Path String userId) {
        userService.delete(userId);
        return HttpServerResponse.of(204);
    }

    // DTOs (typically in separate files)

    @Json
    public record UserRequest(String email, String name) {}

    @Json
    public record UserResponse(String id, String email, String name) {}

    // Application service (typically in a separate file)

    public interface UserService {
        Optional<UserResponse> findById(String id);
        List<UserResponse> findAll(int page, int size);
        UserResponse create(UserRequest request);
        Optional<UserResponse> update(String id, UserRequest request);
        void delete(String id);
    }
}

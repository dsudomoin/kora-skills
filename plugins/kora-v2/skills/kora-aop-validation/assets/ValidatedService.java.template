// Kora 2.0 service using the @Validate aspect.
//
// The generated AOP proxy is `$OrdersService__AopProxy extends OrdersService`, so the class must NOT
// be final, the method must not be final or private, and a non-private constructor must exist.
// A violation of any of those is a compile error in both languages ("AOP aspect cannot be applied
// to class '...' because the class is final" / "... is not open"). Only an abstract class or an
// interface is skipped silently, and only in Java.
//
// For HTTP 400 mapping see references/violation-exception-reference.md.
// Replace `com.example.app.service` / `com.example.app.dto` with your packages.

package com.example.app.service;

import com.example.app.dto.CreateOrder;
import com.example.app.dto.Order;
import io.koraframework.common.annotation.Component;
import io.koraframework.validation.common.Validator;
import io.koraframework.validation.common.annotation.NotBlank;
import io.koraframework.validation.common.annotation.Size;
import io.koraframework.validation.common.annotation.Valid;
import io.koraframework.validation.common.annotation.Validate;

import java.util.List;
import java.util.UUID;

@Component
public class OrdersService {                                  // NOT final

    private final Validator<CreateOrder> bodyValidator;       // supplied by the @Valid DI extension

    public OrdersService(Validator<CreateOrder> bodyValidator) {
        this.bodyValidator = bodyValidator;
    }

    // Declarative: arguments are validated before the body runs.
    @Validate
    public Order create(@Valid CreateOrder body, @NotBlank String tenantId) {
        return new Order(UUID.randomUUID(), body.sku(), body.quantity(), tenantId);
    }

    // failFast = true throws on the first violation instead of collecting all of them.
    @Validate(failFast = true)
    public Order createFast(@Valid CreateOrder body) {
        return new Order(UUID.randomUUID(), body.sku(), body.quantity(), "default");
    }

    // Result validation: @Validate enables the aspect, @Valid validates the returned elements,
    // @Size constrains the list itself. Constraints for the result go on the METHOD.
    @Size(min = 1, max = 100)
    @Valid
    @Validate
    public List<Order> findAll(@NotBlank String tenantId) {
        return List.of(new Order(UUID.randomUUID(), "SKU-1", 1, tenantId));
    }

    // Imperative: full control over when and how failures are handled.
    public Order createManual(CreateOrder body) {
        bodyValidator.validateAndThrow(body);                          // collect all, then throw
        // ...or stop at the first violation:
        // bodyValidator.validateAndThrow(body, io.koraframework.validation.common.ValidationContext.failFast());
        return new Order(UUID.randomUUID(), body.sku(), body.quantity(), "default");
    }
}

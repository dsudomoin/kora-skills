// Kora 2.0 DTO with built-in constraints. @Valid generates $CreateOrder_Validator and registers
// Validator<CreateOrder> in the DI graph — inject the interface, never the generated class.
// Constraints come from io.koraframework.validation.common.annotation, NOT jakarta.validation.
// Replace `com.example.app.dto` with your package.

package com.example.app.dto;

import io.koraframework.validation.common.annotation.NotBlank;
import io.koraframework.validation.common.annotation.NotEmpty;
import io.koraframework.validation.common.annotation.OneOf;
import io.koraframework.validation.common.annotation.Pattern;
import io.koraframework.validation.common.annotation.Range;
import io.koraframework.validation.common.annotation.Size;
import io.koraframework.validation.common.annotation.UUID;
import io.koraframework.validation.common.annotation.Valid;
import org.jspecify.annotations.Nullable;

import java.util.List;

@Valid
public record CreateOrder(
    @NotBlank @Size(min = 1, max = 64) String sku,
    @Range(from = 1, to = 1000) int quantity,            // primitives are boxed before binding
    @Pattern("^[A-Z]{3}$") String currency,              // `value` is the unnamed attribute
    @OneOf({"STANDARD", "EXPRESS"}) String shipping,
    @UUID String traceId,
    @NotEmpty List<String> tags,
    @Valid Address billing,                              // nested @Valid -> Validator<Address>
    @Valid List<OrderLine> lines,                        // element paths render as lines.[0].sku
    @Nullable String note                                // opts the field out of the null check
) {

    // Every field is implicitly required — there is no @NotNull in Kora.
    // Mark optional fields @Nullable (JSpecify); nothing is generated for them.

    @Valid
    public record Address(
        @NotBlank String line1,
        @Nullable String line2,
        @Pattern("^[A-Z]{2}$") String country
    ) {}

    @Valid
    public record OrderLine(
        @NotBlank String sku,
        @Range(from = 1, to = 100) int quantity
    ) {}
}

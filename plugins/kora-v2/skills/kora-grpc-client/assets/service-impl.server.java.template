package ${package};

import io.grpc.Status;
import io.grpc.stub.StreamObserver;
import io.koraframework.common.annotation.Component;
import ${proto_package}.${service_name}Grpc;
import ${proto_package}.${request_class};
import ${proto_package}.${response_class};

/**
 * Counterpart gRPC service implementation (Kora 2.0).
 * The authoritative server guidance is the kora-grpc-server skill.
 *
 * A @Component extending a generated *ImplBase is a BindableService, which
 * GrpcServerFactoryModule collects and registers — no @Tag and no registration call.
 */
@Component
public final class ${service_name}Service extends ${service_name}Grpc.${service_name}ImplBase {

    @Override
    public void ${method_name}(${request_class} request, StreamObserver<${response_class}> responseObserver) {
        try {
            var response = ${response_class}.newBuilder()
                // .setMessage(...)
                .build();

            responseObserver.onNext(response);
            responseObserver.onCompleted();
        } catch (Exception e) {
            // Exactly one of onCompleted/onError may be called, and never both. An exception that
            // escapes this method reaches the client as an opaque UNKNOWN.
            responseObserver.onError(Status.INTERNAL
                .withDescription(e.getMessage())
                .withCause(e)
                .asRuntimeException());
        }
    }
}
